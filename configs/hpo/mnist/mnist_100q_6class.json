{
  "study_name": "mnist_100q_6class",
  "n_trials": 60,
  "n_jobs": 8,
  "sampler_seed": 42,
  "output_dir": "out/hpo",
  "objective_metric": "test_mmd",
  "dataset": {
    "name": "mnist",
    "params": {
      "rows": 10,
      "cols": 10,
      "threshold": 0.4,
      "classes": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "test_samples": 1200,
      "balanced_per_class": true,
      "data_dir": "./data"
    }
  },
  "plot": {
    "kind": "none"
  },
  "fixed_config": {
    "train_samples": 4800,
    "data_seed": 42,
    "n_samples": 2048,
    "epochs_per_step": 512,
    "caching_level": "none",
    "init_baseline": "covariance",
    "init_later": "random",
    "lambda_dual": 1.0,
    "lambda_schedule": {
      "type": "frank_wolfe",
      "gamma": 1.0,
      "tau": 1.0
    },
    "sigma": [
      5.0,
      2.5,
      1.5,
      1.0
    ],
    "weight_strategy": "frank_wolfe",
    "baseline": "none",
    "shots": 10000,
    "acceptance_metric": "training_mmd",
    "skip_sampling": true,
    "final_eval_sampling": false,
    "report_fcfw": true,
    "keep_models_for_diagnosis": true,
    "stop_on_reject": false,
    "rng_seed": 42,
    "turbo": 32,
    "circuit_config": {
      "topology": "aachen_heavy_hex",
      "n_ancilla": 0,
      "num_layers": 1
    },
    "n_models": 10,
    "monitor_interval": null,
    "compute_snr": false,
    "clear_jax_caches": true,
    "n_ops": 4096
  },
  "search_space": {
    "learning_rate": {
      "type": "float",
      "low": 0.001,
      "high": 0.1,
      "log": true
    },
    "dynamic_is": {
      "type": "categorical",
      "choices": [
        false,
        true
      ]
    },
    "dynamic_is_beta": {
      "type": "float",
      "low": 0.01,
      "high": 0.2,
      "log": true
    },
    "lambda_schedule.gamma": {
      "type": "float",
      "low": 0.01,
      "high": 1.0,
      "log": true
    },
    "lambda_schedule.tau": {
      "type": "float",
      "low": 0.01,
      "high": 10.0,
      "log": true
    }
  },
  "best_retrains": {
    "n_seeds": 5,
    "seed_start": 0,
    "baseline": "standalone",
    "report_fcfw": true,
    "skip_sampling": true,
    "final_eval_sampling": false,
    "config_overrides": {
      "turbo": 10,
      "monitor_interval": 10,
      "compute_snr": true,
      "clear_jax_caches": true
    }
  }
}