{
    "output": {
        "base_dir": "out",
        "suite_name": "metrics_smoke_hopfield_6q"
    },
    "defaults": {
        "train_samples": 128,
        "data_seed": 42,
        "n_samples": 128,
        "n_models": 3,
        "learning_rate": 0.01,
        "epochs_per_step": 10,
        "caching_level": "none",
        "ensemble_samples_coeff": 1.0,
        "init_baseline": "covariance",
        "init_later": "random",
        "lambda_dual": 1.0,
        "lambda_schedule": {
            "type": "frank_wolfe",
            "gamma": 1.0,
            "tau": 1.0
        },
        "sigma_factor": [
            0.5
        ],
        "n_ops": 128,
        "weight_strategy": "frank_wolfe",
        "baseline": "standalone",
        "shots": 256,
        "acceptance_metric": "training_mmd",
        "skip_sampling": false,
        "final_eval_sampling": true,
        "dataset_metrics": true,
        "report_fcfw": true,
        "keep_models_for_diagnosis": true,
        "stop_on_reject": false,
        "exact_metrics": {
            "enabled": true,
            "max_qubits": 12,
            "phases": {
                "baseline": true,
                "steps": true,
                "final": true,
                "per_model": true,
                "fcfw": true
            }
        },
        "rng_seed": 42,
        "turbo": 1,
        "circuit_config": {
            "topology": "neighbour",
            "distance": 1,
            "periodic": false,
            "max_weight": 2,
            "n_ancilla": 0
        }
    },
    "runs": [
        {
            "name": "hopfield_6q_metrics_smoke",
            "dataset": {
                "name": "hopfield",
                "params": {
                    "n_qubits": 6,
                    "n_patterns": 2,
                    "beta": 1.5,
                    "pattern_seed": 42,
                    "max_exact_states": 4096
                }
            },
            "plot": {
                "kind": "boltzmann_summary"
            }
        }
    ]
}
