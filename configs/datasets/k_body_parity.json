{
  "output": {
    "base_dir": "out",
    "suite_name": "k_body_parity"
  },
  "runs": [
    {
      "name": "k_body_parity_20q",
      "dataset": {
        "name": "k_body_parity",
        "params": {
          "n_qubits": 20,
          "k": 10,
          "parity": 1,
          "subset_seed": 0
        }
      },
      "plot": {
        "kind": "histogram",
        "params": {
          "filename": "k_body_parity_distribution.pdf"
        }
      },
      "config": {
        "dim": 20,
        "train_samples": 2000,
        "data_seed": 321,
        "n_samples": 1000,
        "n_models": 2,
        "learning_rate": 0.01,
        "epochs_per_step": 20,
        "caching_level": "none",
        "ensemble_samples_coeff": 1.0,
        "init_baseline": "covariance",
        "init_later": "random",
        "lambda_dual": 1.0,
        "sigma_factor": 0.5,
        "n_ops": 1000,
        "weight_strategy": "frank_wolfe",
        "baseline": "standalone",
        "shots": 1000,
        "skip_sampling": true,
        "rng_seed": 42,
        "circuit_config": {
          "topology": "neighbour",
          "distance": 3,
          "max_weight": 2
        },
        "turbo": 10
      }
    }
  ]
}
