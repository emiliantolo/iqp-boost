{
  "output": {
    "base_dir": "out",
    "suite_name": "barabasi_albert_graph"
  },
  "runs": [
    {
      "name": "barabasi_albert_graph_8n",
      "dataset": {
        "name": "barabasi_albert_graph",
        "params": {
          "nodes": 8,
          "m": 2,
          "n_graphs": 160,
          "train_split_ratio": 0.8,
          "seed": 42,
          "store_graphs": false
        }
      },
      "plot": {
        "kind": "none"
